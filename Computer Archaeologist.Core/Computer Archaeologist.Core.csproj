<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ComputerArchaeologist.Core</RootNamespace>
    <AssemblyName>ComputerArchaeologist.Core</AssemblyName>
    <Platforms>AnyCPU;x86;x64;ARM64</Platforms>
    <LangVersion>latest</LangVersion>
    <!-- Windows-only APIs in this library are always guarded with OperatingSystem.IsWindows()
         and the library is only ever consumed by a Windows desktop application. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>

    <!-- Authorship -->
    <Authors>Aperture-Revive</Authors>
    <Company>Aperture-Revive</Company>
    <Product>Computer Archaeologist</Product>
    <Description>Core library for Computer Archaeologist.</Description>
    <Copyright>Copyright (c) 2026 @Aperture-Revive</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.12" />
    <PackageReference Include="OpenAI" Version="2.14.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <!-- The test project exercises the internal discovery and scoring helpers directly. -->
    <InternalsVisibleTo Include="ComputerArchaeologist.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Canonical translation catalogue. The very same .resw documents are consumed by the Windows
         App SDK PRI pipeline in the application project, so there is exactly one source of truth. -->
    <EmbeddedResource Include="Strings\**\*.resw" />
  </ItemGroup>

</Project>
