<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>ComputerArchaeologist</RootNamespace>
    <AssemblyName>Computer Archaeologist</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64;AnyCPU</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!--
      CA1416: this assembly is Windows-only by construction.
      MVVMTK0045: the toolkit asks for partial properties instead of fields so that Native AOT can
      generate WinRT marshalling code. This application is published framework-dependent and is never
      trimmed or AOT-compiled (see the PublishTrimmed setting below), so the field-based
      [ObservableProperty] pattern is fully supported here.
    -->
    <NoWarn>$(NoWarn);CA1416;MVVMTK0045</NoWarn>

    <!-- Authorship -->
    <Authors>Aperture-Revive</Authors>
    <Company>Aperture-Revive</Company>
    <Product>Computer Archaeologist</Product>
    <Description>Rediscover the forgotten corners of your computer.</Description>
    <Copyright>Copyright (c) 2026 @Aperture-Revive</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Version>1.0.0</Version>
    <RepositoryType>git</RepositoryType>

    <!--
      The application ships as a self-contained Windows App SDK app so that it starts on any
      Windows 10 1809+ machine without a separate Windows App Runtime installation, and without
      requiring an MSIX deployment during development. The packaged manifest is still present and is
      used when publishing through the Single-project MSIX tooling.
    -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Platform)' == 'x86'">
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)' == 'ARM64'">
    <RuntimeIdentifier>win-arm64</RuntimeIdentifier>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)' == 'x64' Or '$(Platform)' == 'AnyCPU' Or '$(Platform)' == ''">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The translation catalogue physically lives in the Core library so that the embedded copy and the
      PRI copy can never drift apart. This links the very same .resw files into the Windows resource
      pipeline so the standard WinUI localisation mechanism also sees them.
    -->
    <PRIResource Include="..\Computer Archaeologist.Core\Strings\**\*.resw">
      <Link>Strings\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </PRIResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.12" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />

    <!--
      Windows App SDK 2.x is shipped as components. Referencing the components this application
      actually uses, instead of the metapackage, keeps the unused AI, ML, Search and Widgets payload
      (onnxruntime, DirectML, the Windows.AI projections and friends - roughly 60 MB) out of the build
      output entirely. Versions match what Microsoft.WindowsAppSDK 2.5.1 pins.
    -->
    <PackageReference Include="Microsoft.WindowsAppSDK.Base" Version="2.0.4" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" Version="2.3.12" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.1.9" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.9" />
    <PackageReference Include="Microsoft.WindowsAppSDK.DWrite" Version="2.1.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="2.5.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Computer Archaeologist.Core\Computer Archaeologist.Core.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>

  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!-- Publish Properties -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <PublishTrimmed>False</PublishTrimmed>
  </PropertyGroup>

</Project>
