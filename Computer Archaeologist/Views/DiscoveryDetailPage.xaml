<?xml version="1.0" encoding="utf-8"?>
<local:AppPage
    x:Class="ComputerArchaeologist.Views.DiscoveryDetailPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:ComputerArchaeologist.Views"
    xmlns:vm="using:ComputerArchaeologist.ViewModels"
    mc:Ignorable="d">

    <Grid Padding="32,20,32,0" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============ command bar ============ -->
        <StackPanel Grid.Row="0" Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Command="{Binding BackCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72B;" FontSize="12" />
                        <TextBlock Text="{Binding BackText}" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding OpenFileCommand}">
                    <TextBlock Text="{Binding OpenButtonText}" />
                </Button>
                <Button Command="{Binding OpenFolderCommand}">
                    <TextBlock Text="{Binding OpenFolderText}" />
                </Button>
                <Button Command="{Binding CopyPathCommand}">
                    <TextBlock Text="{Binding CopyPathText}" />
                </Button>
            </StackPanel>

            <TextBlock Text="{Binding StatusMessage}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap"
                       Visibility="{Binding StatusVisible, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Padding="0,0,0,40">
            <StackPanel Spacing="16" MaxWidth="1180" HorizontalAlignment="Stretch">

                <!-- ============ header ============ -->
                <Border Style="{StaticResource CardBorder}">
                    <Grid ColumnSpacing="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon Grid.Column="0" Glyph="{Binding Artifact.File.Extension, Converter={StaticResource FileGlyph}}"
                                  FontSize="30" VerticalAlignment="Top" Margin="0,4,0,0"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock Text="{Binding FileName}" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding FullPath}" Style="{StaticResource MonoTextBlock}" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Border Style="{StaticResource ScorePillBorder}">
                                    <TextBlock Text="{Binding Category}" Style="{StaticResource CaptionTextBlockStyle}" />
                                </Border>
                                <TextBlock Text="{Binding ConfidenceText}" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Spacing="4" MinWidth="180">
                            <TextBlock Text="{Binding [Disc_ScoreLabel], Source={StaticResource Loc}}"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" />
                            <TextBlock Text="{Binding ScoreText}" Style="{StaticResource TitleLargeTextBlockStyle}"
                                       HorizontalAlignment="Right"
                                       Foreground="{Binding ScoreValue, Converter={StaticResource ScoreToBrush}}" />
                            <ProgressBar Value="{Binding ScoreValue}" Maximum="100" Width="160" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ============ why ============ -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{Binding [Detail_Why], Source={StaticResource Loc}}" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="{Binding WhyText}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />

                        <TextBlock Text="{Binding AiSummary}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                   FontStyle="Italic"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Visibility="{Binding HasAi, Converter={StaticResource BoolToVisibility}}" />

                        <TextBlock Text="{Binding NarrativeNote}" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Visibility="{Binding HasNarrativeNote, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Border>

                <!-- ============ score breakdown ============ -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{Binding BreakdownTitle}" Style="{StaticResource SubtitleTextBlockStyle}" />

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource SubtleCardBorder}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding [Feature_LocalScore], Source={StaticResource Loc}}"
                                               Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{Binding LocalScoreText}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource SubtleCardBorder}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding [Feature_AiScore], Source={StaticResource Loc}}"
                                               Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{Binding AiScoreText}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource SubtleCardBorder}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding [Detail_AiConfidence], Source={StaticResource Loc}}"
                                               Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{Binding ConfidenceText}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <ListView ItemsSource="{Binding Features}" SelectionMode="None" IsItemClickEnabled="False">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0,2" />
                                    <Setter Property="MinHeight" Value="0" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:FeatureRow">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                        <ProgressBar Grid.Column="1" Value="{x:Bind Value}" Maximum="100" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind Value}" MinWidth="48" TextAlignment="Right"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                            <Expander.Header>
                                <TextBlock Text="{Binding [Detail_LocalReasons], Source={StaticResource Loc}}" />
                            </Expander.Header>
                            <ItemsControl ItemsSource="{Binding LocalReasons}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{x:Bind}" TextWrapping="Wrap" Margin="0,2" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>

                        <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                  Visibility="{Binding HasAi, Converter={StaticResource BoolToVisibility}}">
                            <Expander.Header>
                                <TextBlock Text="{Binding [Detail_AiReasons], Source={StaticResource Loc}}" />
                            </Expander.Header>
                            <ItemsControl ItemsSource="{Binding AiReasons}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{x:Bind}" TextWrapping="Wrap" Margin="0,2" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                    </StackPanel>
                </Border>

                <!-- ============ facts ============ -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{Binding FactsTitle}" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <ItemsControl ItemsSource="{Binding Facts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:FactRow">
                                    <Grid ColumnSpacing="12" Padding="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" MinWidth="150" MaxWidth="220" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Bind Label}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Value}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ============ preview ============ -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{Binding PreviewTitle}" Style="{StaticResource SubtitleTextBlockStyle}" />

                        <Image Source="{Binding PreviewImagePath, Converter={StaticResource Thumbnail}}" MaxHeight="320" Stretch="Uniform" HorizontalAlignment="Left"
                               Visibility="{Binding HasPreviewImage, Converter={StaticResource BoolToVisibility}}" />

                        <ScrollViewer MaxHeight="320" HorizontalScrollBarVisibility="Auto"
                                      Visibility="{Binding HasPreviewText, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding PreviewText}" Style="{StaticResource MonoTextBlock}" />
                        </ScrollViewer>

                        <TextBlock Text="{Binding PreviewNote}" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- ============ timeline ============ -->
                <Border Style="{StaticResource CardBorder}" Visibility="{Binding HasTimeline, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{Binding TimelineTitle}" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <ItemsControl ItemsSource="{Binding Timeline}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:TimelinePoint">
                                    <Grid ColumnSpacing="12" Padding="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Grid.Column="0" Style="{StaticResource TimelineDot}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Label}" Margin="8,0,0,0"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind Value}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ============ related files ============ -->
                <Border Style="{StaticResource CardBorder}" Visibility="{Binding HasRelatedFiles, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="{Binding RelatedTitle}" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <ItemsRepeater ItemsSource="{Binding RelatedFiles}">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout Orientation="Horizontal"
                                                   MinItemWidth="220" MinItemHeight="28"
                                                   MinColumnSpacing="12" MinRowSpacing="6"
                                                   ItemsStretch="Fill" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{x:Bind}" Style="{StaticResource MonoTextBlock}" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </Border>

            </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</local:AppPage>
