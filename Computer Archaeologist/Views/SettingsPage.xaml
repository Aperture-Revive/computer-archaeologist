<?xml version="1.0" encoding="utf-8"?>
<local:AppPage
    x:Class="ComputerArchaeologist.Views.SettingsPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:ComputerArchaeologist.Views"
    xmlns:vm="using:ComputerArchaeologist.ViewModels"
    mc:Ignorable="d">

    <Grid Padding="32,24,32,0" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="{Binding [Settings_Title], Source={StaticResource Loc}}" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="{Binding [Settings_Subtitle], Source={StaticResource Loc}}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                <Button Style="{StaticResource AccentButtonStyle}" Command="{Binding SaveCommand}">
                    <TextBlock Text="{Binding [Common_Save], Source={StaticResource Loc}}" />
                </Button>
                <Button Command="{Binding RequestResetToDefaultsCommand}">
                    <TextBlock Text="{Binding [Settings_ResetDefaults], Source={StaticResource Loc}}" />
                </Button>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="16" MaxWidth="1000" HorizontalAlignment="Left" Padding="0,0,0,40">

                <TextBlock Text="{Binding StatusMessage}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" Visibility="{Binding StatusVisible, Converter={StaticResource BoolToVisibility}}" />

                <!-- ==================== OpenAI ==================== -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{Binding [Settings_OpenAi], Source={StaticResource Loc}}" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock Text="{Binding [Settings_OpenAi_Desc], Source={StaticResource Loc}}"
                                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>

                        <Grid ColumnSpacing="20" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                                <TextBlock Text="{Binding [Settings_ApiKey], Source={StaticResource Loc}}" />
                                <PasswordBox Password="{Binding ApiKeyInput, Mode=TwoWay}"
                                             PlaceholderText="{Binding [Settings_ApiKey_Placeholder], Source={StaticResource Loc}}" />
                                <TextBlock Text="{Binding KeyStorageText}" Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
                                <TextBlock Text="{Binding [Settings_BaseUrl], Source={StaticResource Loc}}" />
                                <TextBox Text="{Binding BaseUrl, Mode=TwoWay}" PlaceholderText="https://api.openai.com/v1" />
                                <TextBlock Text="{Binding [Settings_Model], Source={StaticResource Loc}}" Margin="0,8,0,0" />
                                <TextBox Text="{Binding Model, Mode=TwoWay}" PlaceholderText="gpt-4o-mini" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Command="{Binding TestConnectionCommand}">
                                <TextBlock Text="{Binding [Settings_TestConnection], Source={StaticResource Loc}}" />
                            </Button>
                            <ProgressRing Width="18" Height="18" IsActive="{Binding IsTesting, Mode=OneWay}"
                                          Visibility="{Binding IsTesting, Converter={StaticResource BoolToVisibility}}" />
                            <Button Command="{Binding ClearKeyCommand}">
                                <TextBlock Text="{Binding [Settings_ClearKey], Source={StaticResource Loc}}" />
                            </Button>
                        </StackPanel>

                        <InfoBar IsOpen="{Binding ConnectionStatusVisible, Mode=OneWay}"
                                 IsClosable="False"
                                 Severity="Success"
                                 Message="{Binding ConnectionStatus}"
                                 Visibility="{Binding ConnectionSucceeded, Converter={StaticResource BoolToVisibility}}" />
                        <InfoBar IsOpen="{Binding ConnectionStatusVisible, Mode=OneWay}"
                                 IsClosable="False"
                                 Severity="Error"
                                 Message="{Binding ConnectionStatus}"
                                 Visibility="{Binding ConnectionSucceeded, Converter={StaticResource InverseBoolToVisibility}}" />
                    </StackPanel>
                </Border>

                <!-- ==================== File discovery ==================== -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel Spacing="14">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{Binding [Settings_Discovery], Source={StaticResource Loc}}" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock Text="{Binding [Settings_Discovery_Desc], Source={StaticResource Loc}}"
                                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>

                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="{Binding [Settings_Discovery_MaxFiles], Source={StaticResource Loc}}" TextWrapping="Wrap" />
                                <NumberBox Value="{Binding MaxFiles, Mode=TwoWay}" Minimum="1000" Maximum="20000000"
                                           SpinButtonPlacementMode="Compact" SmallChange="50000" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="{Binding [Settings_Discovery_Budget], Source={StaticResource Loc}}" TextWrapping="Wrap" />
                                <NumberBox Value="{Binding BudgetMinutes, Mode=TwoWay}" Minimum="0" Maximum="240"
                                           SpinButtonPlacementMode="Compact" SmallChange="1" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="4">
                                <TextBlock Text="{Binding [Settings_Discovery_Concurrency], Source={StaticResource Loc}}" TextWrapping="Wrap" />
                                <NumberBox Value="{Binding DiscoveryConcurrency, Mode=TwoWay}" Minimum="1" Maximum="32"
                                           SpinButtonPlacementMode="Compact" SmallChange="1" />
                                <TextBlock Text="{Binding [Settings_Discovery_Concurrency_Desc], Source={StaticResource Loc}}"
                                           Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ==================== Privacy ==================== -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel Spacing="14">
                        <TextBlock Text="{Binding [Settings_Privacy], Source={StaticResource Loc}}" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <InfoBar IsOpen="True" Severity="Informational" IsClosable="False"
                                 Message="{Binding [Settings_Privacy_Notice], Source={StaticResource Loc}}" />

                        <!--
                            RadioButtons wraps each child in its own RadioButton container, so the items
                            here are plain content. Nesting RadioButton elements would let the container
                            push an unintended SelectedIndex back through the two-way binding.
                        -->
                        <RadioButtons SelectedIndex="{Binding PrivacyIndex, Mode=TwoWay}">
                            <StackPanel Spacing="2" Margin="0,4">
                                <TextBlock Text="{Binding [Settings_Privacy_Metadata], Source={StaticResource Loc}}" />
                                <TextBlock Text="{Binding [Settings_Privacy_Metadata_Desc], Source={StaticResource Loc}}"
                                           Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Spacing="2" Margin="0,4">
                                <TextBlock Text="{Binding [Settings_Privacy_Smart], Source={StaticResource Loc}}" />
                                <TextBlock Text="{Binding [Settings_Privacy_Smart_Desc], Source={StaticResource Loc}}"
                                           Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Spacing="2" Margin="0,4">
                                <TextBlock Text="{Binding [Settings_Privacy_Off], Source={StaticResource Loc}}" />
                                <TextBlock Text="{Binding [Settings_Privacy_Off_Desc], Source={StaticResource Loc}}"
                                           Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </RadioButtons>
                    </StackPanel>
                </Border>

                <!-- ==================== Archaeology ==================== -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel Spacing="14">
                        <TextBlock Text="{Binding [Settings_Archaeology], Source={StaticResource Loc}}" Style="{StaticResource SubtitleTextBlockStyle}" />

                        <Grid ColumnSpacing="20" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                                <TextBlock Text="{Binding [Settings_MaxScan], Source={StaticResource Loc}}" TextWrapping="Wrap" />
                                <NumberBox Value="{Binding MaxScanFiles, Mode=TwoWay}" Minimum="1000" Maximum="5000000"
                                           SpinButtonPlacementMode="Compact" SmallChange="10000" />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Spacing="4">
                                <TextBlock Text="{Binding [Settings_MaxCandidates], Source={StaticResource Loc}}" TextWrapping="Wrap" />
                                <NumberBox Value="{Binding MaxCandidates, Mode=TwoWay}" Minimum="50" Maximum="200000"
                                           SpinButtonPlacementMode="Compact" SmallChange="500" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0" Spacing="4">
                                <TextBlock Text="{Binding [Settings_MaxAi], Source={StaticResource Loc}}" TextWrapping="Wrap" />
                                <NumberBox Value="{Binding MaxAiAnalysis, Mode=TwoWay}" Minimum="0" Maximum="5000"
                                           SpinButtonPlacementMode="Compact" SmallChange="50" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4">
                                <TextBlock Text="{Binding [Settings_MaxDiscoveries], Source={StaticResource Loc}}" TextWrapping="Wrap" />
                                <NumberBox Value="{Binding MaxDiscoveries, Mode=TwoWay}" Minimum="5" Maximum="500"
                                           SpinButtonPlacementMode="Compact" SmallChange="5" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="0" Spacing="4">
                                <TextBlock Text="{Binding [Settings_MinScore], Source={StaticResource Loc}}" TextWrapping="Wrap" />
                                <NumberBox Value="{Binding MinInterestingness, Mode=TwoWay}" Minimum="0" Maximum="100"
                                           SpinButtonPlacementMode="Compact" SmallChange="5" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="1" Spacing="4">
                                <TextBlock Text="{Binding [Settings_MaxContentBytes], Source={StaticResource Loc}}" TextWrapping="Wrap" />
                                <NumberBox Value="{Binding MaxContentBytes, Mode=TwoWay}" Minimum="512" Maximum="262144"
                                           SpinButtonPlacementMode="Compact" SmallChange="1024" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Spacing="4">
                            <ToggleSwitch IsOn="{Binding AnalyzeCode, Mode=TwoWay}" Header="{Binding [Settings_AnalyzeCode], Source={StaticResource Loc}}" />
                            <ToggleSwitch IsOn="{Binding AnalyzeImages, Mode=TwoWay}" Header="{Binding [Settings_AnalyzeImages], Source={StaticResource Loc}}" />
                            <TextBlock Text="{Binding [Settings_AnalyzeImages_Desc], Source={StaticResource Loc}}"
                                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                       TextWrapping="Wrap" Margin="0,0,0,4" />
                            <ToggleSwitch IsOn="{Binding AnalyzeArchives, Mode=TwoWay}" Header="{Binding [Settings_AnalyzeArchives], Source={StaticResource Loc}}" />
                            <ToggleSwitch IsOn="{Binding ComputeHashes, Mode=TwoWay}" Header="{Binding [Settings_HashTop], Source={StaticResource Loc}}" />
                        </StackPanel>

                        <!-- excluded paths -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="{Binding [Settings_ExcludedPaths], Source={StaticResource Loc}}" />
                            <TextBlock Text="{Binding [Settings_ExcludedPaths_Desc], Source={StaticResource Loc}}"
                                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding NewExcludedPath, Mode=TwoWay}"
                                         PlaceholderText="{Binding [Settings_AddPlaceholder_Path], Source={StaticResource Loc}}" />
                                <Button Grid.Column="1" Command="{Binding AddExcludedPathCommand}">
                                    <TextBlock Text="{Binding [Common_Add], Source={StaticResource Loc}}" />
                                </Button>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding ExcludedPaths}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ListEntryViewModel">
                                        <Grid ColumnSpacing="8" Padding="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{x:Bind Value}" Style="{StaticResource MonoTextBlock}" TextTrimming="CharacterEllipsis" />
                                            <Button Grid.Column="1" Padding="6,0" Command="{x:Bind RemoveCommand}">
                                                <FontIcon Glyph="&#xE711;" FontSize="11" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- excluded extensions -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="{Binding [Settings_ExcludedExtensions], Source={StaticResource Loc}}" />
                            <TextBlock Text="{Binding [Settings_ExcludedExtensions_Desc], Source={StaticResource Loc}}"
                                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding NewExcludedExtension, Mode=TwoWay}"
                                         PlaceholderText="{Binding [Settings_AddPlaceholder_Extension], Source={StaticResource Loc}}" />
                                <Button Grid.Column="1" Command="{Binding AddExcludedExtensionCommand}">
                                    <TextBlock Text="{Binding [Common_Add], Source={StaticResource Loc}}" />
                                </Button>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding ExcludedExtensions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ListEntryViewModel">
                                        <Grid ColumnSpacing="8" Padding="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{x:Bind Value}" Style="{StaticResource MonoTextBlock}" TextTrimming="CharacterEllipsis" />
                                            <Button Grid.Column="1" Padding="6,0" Command="{x:Bind RemoveCommand}">
                                                <FontIcon Glyph="&#xE711;" FontSize="11" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- included roots -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="{Binding [Settings_IncludedRoots], Source={StaticResource Loc}}" />
                            <TextBlock Text="{Binding [Settings_IncludedRoots_Desc], Source={StaticResource Loc}}"
                                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Command="{Binding AddIncludedRootCommand}">
                                    <TextBlock Text="{Binding [Common_Browse], Source={StaticResource Loc}}" />
                                </Button>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding IncludedRoots}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ListEntryViewModel">
                                        <Grid ColumnSpacing="8" Padding="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{x:Bind Value}" Style="{StaticResource MonoTextBlock}" TextTrimming="CharacterEllipsis" />
                                            <Button Grid.Column="1" Padding="6,0" Command="{x:Bind RemoveCommand}">
                                                <FontIcon Glyph="&#xE711;" FontSize="11" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ==================== Appearance + language ==================== -->
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel Spacing="14">
                        <TextBlock Text="{Binding [Settings_Appearance], Source={StaticResource Loc}}" Style="{StaticResource SubtitleTextBlockStyle}" />

                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding [Settings_Theme], Source={StaticResource Loc}}" />
                            <RadioButtons SelectedIndex="{Binding ThemeIndex, Mode=TwoWay}">
                                <TextBlock Text="{Binding [Settings_Theme_System], Source={StaticResource Loc}}" Margin="0,4" />
                                <TextBlock Text="{Binding [Settings_Theme_Light], Source={StaticResource Loc}}" Margin="0,4" />
                                <TextBlock Text="{Binding [Settings_Theme_Dark], Source={StaticResource Loc}}" Margin="0,4" />
                            </RadioButtons>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding [Settings_Language], Source={StaticResource Loc}}" />
                            <ComboBox MinWidth="240" SelectedIndex="{Binding LanguageIndex, Mode=TwoWay}"
                                      AutomationProperties.Name="{Binding [Settings_Language], Source={StaticResource Loc}}">
                                <ComboBoxItem Content="{Binding [Settings_Language_System], Source={StaticResource Loc}}" />
                                <ComboBoxItem Content="English" />
                                <ComboBoxItem Content="简体中文" />
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ==================== Advanced ==================== -->
                <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <Expander.Header>
                        <TextBlock Text="{Binding [Settings_Advanced], Source={StaticResource Loc}}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    </Expander.Header>
                    <StackPanel Spacing="14" Margin="0,10,0,0">

                        <Grid ColumnSpacing="20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="{Binding [Settings_Concurrency], Source={StaticResource Loc}}" TextWrapping="Wrap" />
                                <NumberBox Value="{Binding MaxConcurrency, Mode=TwoWay}" Minimum="1" Maximum="8" SpinButtonPlacementMode="Compact" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="{Binding [Settings_Timeout], Source={StaticResource Loc}}" TextWrapping="Wrap" />
                                <NumberBox Value="{Binding TimeoutSeconds, Mode=TwoWay}" Minimum="5" Maximum="600" SpinButtonPlacementMode="Compact" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="4">
                                <TextBlock Text="{Binding [Settings_Retries], Source={StaticResource Loc}}" TextWrapping="Wrap" />
                                <NumberBox Value="{Binding MaxRetries, Mode=TwoWay}" Minimum="0" Maximum="6" SpinButtonPlacementMode="Compact" />
                            </StackPanel>
                        </Grid>

                        <ToggleSwitch IsOn="{Binding UseJsonResponseFormat, Mode=TwoWay}" Header="{Binding [Settings_JsonMode], Source={StaticResource Loc}}" />
                        <ToggleSwitch IsOn="{Binding AllowBuiltInFallback, Mode=TwoWay}" Header="{Binding [Settings_Fallback], Source={StaticResource Loc}}" />
                        <TextBlock Text="{Binding [Settings_Fallback_Desc], Source={StaticResource Loc}}"
                                   Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />

                        <StackPanel Spacing="6">
                            <TextBlock Text="{Binding [Settings_Weights], Source={StaticResource Loc}}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="{Binding [Settings_Weights_Desc], Source={StaticResource Loc}}"
                                       Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding [Settings_Weight_Ai], Source={StaticResource Loc}}" />
                            <Slider Value="{Binding AiWeight, Mode=TwoWay}" Minimum="0" Maximum="100" StepFrequency="5" />
                            <TextBlock Text="{Binding [Settings_Weight_MinConfidence], Source={StaticResource Loc}}" />
                            <Slider Value="{Binding MinConfidenceScale, Mode=TwoWay}" Minimum="0" Maximum="100" StepFrequency="5" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding [Settings_DataFolder], Source={StaticResource Loc}}" />
                            <TextBlock Text="{Binding DataFolder}" Style="{StaticResource MonoTextBlock}" TextWrapping="Wrap" />
                            <Button Command="{Binding OpenDataFolderCommand}">
                                <TextBlock Text="{Binding [Settings_OpenDataFolder], Source={StaticResource Loc}}" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Expander>

                <!-- Authorship -->
                <TextBlock
                    Text="{Binding [App_Author], Source={StaticResource Loc}}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    HorizontalAlignment="Left" />

            </StackPanel>
        </ScrollViewer>
    </Grid>
</local:AppPage>
